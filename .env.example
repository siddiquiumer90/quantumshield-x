# Copy to .env and fill in real values for production.
# NEVER commit a real .env file.
# NOTE: the backend reads real environment variables, not this file directly —
# export them in your shell, or set them in your process manager. The laptop
# demo needs none of this: built-in defaults just work.

# Strong random secret for JWT signing (production: generate with e.g.
# python -c "import secrets; print(secrets.token_hex(32))").
QS_SECRET_KEY=change-me-to-a-long-random-secret-in-production

# JWT lifetime in hours.
QS_TOKEN_HOURS=24

# Database. Default (laptop demo) is SQLite in backend/data/, resolved
# automatically. Production example:
# DATABASE_URL=postgresql+psycopg2://qs_user:qs_password@db:5432/quantumshield
# DATABASE_URL=sqlite:///D:/quantumshield-x/backend/data/quantumshield.db

# Frontend origin allowed by CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Optional Redis for rate limiting. If unset, in-memory limiting is used.
# REDIS_URL=redis://localhost:6379/0

# Rate limit: requests per minute per IP.
QS_RATE_LIMIT_PER_MINUTE=120

# Upload cap in bytes (default 10 MB).
QS_MAX_UPLOAD_BYTES=10485760

# Where encrypted file blobs are stored.
QS_UPLOAD_DIR=./backend/data/files
